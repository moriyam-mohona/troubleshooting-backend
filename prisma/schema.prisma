generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

enum Role {
  USER
  SUPER_ADMIN
}

enum UserStatus {
  ACTIVE
  BLOCKED
}

enum OtpPurpose {
  EMAIL_VERIFICATION
  PASSWORD_RESET
}

enum OptionChoice {
  YES
  NO
}

model User {
  id              String     @id @default(auto()) @map("_id") @db.ObjectId
  email           String     @unique
  password        String
  name            String?
  role            Role       @default(USER)
  status          UserStatus @default(ACTIVE)
  isEmailVerified Boolean    @default(false)
  isActive        Boolean    @default(true)
  lastLogin       DateTime?
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  otpTokens     OtpToken[]
  refreshTokens RefreshToken[]
  userQuestions UserQuestion[]
  treeSessions  UserTreeSession[]
}

model OtpToken {
  id        String     @id @default(auto()) @map("_id") @db.ObjectId
  userId    String     @db.ObjectId
  otp       String
  purpose   OtpPurpose
  expiresAt DateTime
  used      Boolean    @default(false)
  createdAt DateTime   @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model RefreshToken {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  userId    String   @db.ObjectId
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Category {
  id            String        @id @default(auto()) @map("_id") @db.ObjectId
  title         String
  subtitle      String
  subcategories SubCategory[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model SubCategory {
  id              String            @id @default(auto()) @map("_id") @db.ObjectId
  title           String
  categoryId      String            @db.ObjectId
  category        Category          @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  // Starting root question of this decision tree
  firstQuestionId String?           @db.ObjectId
  firstQuestion   Question?         @relation("FirstQuestion", fields: [firstQuestionId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  isDraft         Boolean           @default(true)
  questions       Question[]
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
  userQuestions   UserQuestion[]
  treeSessions    UserTreeSession[]

  @@index([categoryId])
}

enum RouteOption {
  YES
  NO
}

enum RouteType {
  QUESTION
  ANSWER
}

model Question {
  id             String            @id @default(auto()) @map("_id") @db.ObjectId
  question       String
  subCategoryId  String            @db.ObjectId
  subCategory    SubCategory       @relation(fields: [subCategoryId], references: [id], onDelete: Cascade)
  // Outgoing routes from this question (Yes / No)
  routes         QuestionRoute[]   @relation("FromQuestion")
  // Incoming routes pointing to this question as follow-up
  incomingRoutes QuestionRoute[]   @relation("ToQuestion")
  firstFor       SubCategory[]     @relation("FirstQuestion")
  treeSessions   UserTreeSession[]
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  @@index([subCategoryId])
}

model Answer {
  id             String            @id @default(auto()) @map("_id") @db.ObjectId
  whatsHappening String
  recommendedFix String
  incomingRoutes QuestionRoute[]
  treeSessions   UserTreeSession[]
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt
}

model QuestionRoute {
  id             String      @id @default(auto()) @map("_id") @db.ObjectId
  // The parent question this route starts from
  questionId     String      @db.ObjectId
  question       Question    @relation("FromQuestion", fields: [questionId], references: [id], onDelete: Cascade)
  // YES or NO option
  option         RouteOption
  // QUESTION or ANSWER
  nextType       RouteType
  // If nextType == QUESTION -> links to next Question
  nextQuestionId String?     @db.ObjectId
  nextQuestion   Question?   @relation("ToQuestion", fields: [nextQuestionId], references: [id], onDelete: Cascade)
  // If nextType == ANSWER -> links to Answer
  nextAnswerId   String?     @db.ObjectId
  nextAnswer     Answer?     @relation(fields: [nextAnswerId], references: [id], onDelete: Cascade)
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  @@index([questionId])
  @@index([nextQuestionId])
  @@index([nextAnswerId])
}

enum UserQuestionStatus {
  PENDING
  ANSWERED
}

model UserQuestion {
  id            String      @id @default(auto()) @map("_id") @db.ObjectId
  userId        String      @db.ObjectId
  user          User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  subcategoryId String      @db.ObjectId
  subcategory   SubCategory @relation(fields: [subcategoryId], references: [id], onDelete: Cascade)

  description String
  image       String?
  status      UserQuestionStatus @default(PENDING)
  adminReply  String?
  repliedAt   DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([subcategoryId])
  @@index([status])
}

enum SupportStatus {
  PENDING
  RESOLVED
}

model Support {
  id      String        @id @default(auto()) @map("_id") @db.ObjectId
  userId  String?       @db.ObjectId
  name    String
  email   String
  phone   String?
  subject String?
  message String
  status  SupportStatus @default(PENDING)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([status])
}

enum SessionStatus {
  IN_PROGRESS
  SOLVED
}

model UserTreeSession {
  id                String        @id @default(auto()) @map("_id") @db.ObjectId
  userId            String        @db.ObjectId
  user              User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  subcategoryId     String        @db.ObjectId
  subcategory       SubCategory   @relation(fields: [subcategoryId], references: [id], onDelete: Cascade)

  currentQuestionId String?       @db.ObjectId
  currentQuestion   Question?     @relation(fields: [currentQuestionId], references: [id], onDelete: SetNull)

  currentStep       Int           @default(1)
  status            SessionStatus @default(IN_PROGRESS)

  // Dynamic history of choices taken: [{ step, questionId, questionText, optionChosen }]
  historyPath       Json?

  finalAnswerId     String?       @db.ObjectId
  finalAnswer       Answer?       @relation(fields: [finalAnswerId], references: [id], onDelete: SetNull)

  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  @@index([userId])
  @@index([subcategoryId])
  @@index([status])
}
